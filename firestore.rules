rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Anyone signed in can read profiles (needed for admin search-by-email)
      allow read: if request.auth != null;

      // A user can create their own profile on signup, but cannot set
      // themselves as admin or invent their own competitorId
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.isAdmin == false
                    && request.resource.data.competitorId == null;

      // Users can update their own profile, but never touch isAdmin
      // or competitorId directly — those are admin-only via the app logic.
      // Admins (checked via their own doc) can update any user's doc.
      allow update: if request.auth != null && (
                      (request.auth.uid == userId
                       && request.resource.data.isAdmin == resource.data.isAdmin
                       && request.resource.data.competitorId == resource.data.competitorId)
                      ||
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
                    );

      allow delete: if false;
    }

    match /counters/{year} {
      // Only admins can touch the ID counters (used inside assignCompetitorId)
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // ------------------------------------------------------------------
    // Everything below is content the public homepage reads directly
    // (no login) and the PIN-gated manage.html panel writes to. There is
    // no Firebase Auth for the admin panel — manage.html protects itself
    // with its own client-side PIN — so these stay open at the database
    // level, same as this project has always relied on.
    // ------------------------------------------------------------------

    // Homepage content docs: site/upcomingCompetition, site/results,
    // site/liveResults, site/general, site/reviews, site/faq, site/hallOfFame
    match /site/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Homepage gallery photos
    match /galleryImages/{imageId} {
      allow read: if true;
      allow write: if true;
    }

    // Referral program entries (created by the registration flow, managed
    // from manage.html)
    match /referrals/{referralId} {
      allow read: if true;
      allow write: if true;
    }

    // T&T Records & Rankings — one doc per event (3x3, 2x2, pyraminx, clock, fto, ...).
    match /ttRecords/{eventId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
