rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Profile pictures — one file per user, named by their uid.
    // Publicly readable (so photos show up on the dashboard/admin panel),
    // but only the account owner (or an admin) can upload/replace/delete it.
    match /profilePics/{uid} {
      allow read: if true;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
