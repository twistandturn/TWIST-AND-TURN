<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Upcoming Competition : Twist &amp; Turn</title>
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#E8412B">
<link rel="icon" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<script src="https://cdn.tailwindcss.com"></script>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg-base:#101218;
    --bg-surface:#181B24;
    --ink:#F2F1ED;
    --ink-muted:#9297A6;
    --cube-red:#E8412B;
    --cube-yellow:#F2B705;
    --cube-blue:#2F6FE0;
    --cube-green:#22A35C;
  }
  body{ font-family:'Inter', sans-serif; scroll-behavior:smooth; background:var(--bg-base); color:var(--ink); }
  .font-display{ font-family:'Space Grotesk', sans-serif; }
  .font-mono{ font-family:'JetBrains Mono', monospace; }

  .eyebrow{ font-family:'JetBrains Mono', monospace; font-size:0.75rem; letter-spacing:0.2em; text-transform:uppercase; color:var(--ink-muted); }

  .surface-card{ background:var(--bg-surface); border:1px solid rgba(255,255,255,0.06); }
  .accent-border-red{ border-left:3px solid var(--cube-red); }
  .accent-border-yellow{ border-left:3px solid var(--cube-yellow); }
  .accent-border-blue{ border-left:3px solid var(--cube-blue); }
  .accent-border-green{ border-left:3px solid var(--cube-green); }

  .interactive-card{ position:relative; transition:transform .25s ease, box-shadow .25s ease, border-color .25s ease; will-change:transform, box-shadow; }
  .interactive-card:hover, .interactive-card:focus-within{ transform:translateY(-6px); box-shadow:0 18px 35px rgba(0,0,0,0.35); }
  @media (prefers-reduced-motion: reduce){ .interactive-card:hover{ transform:none; } }

  .btn-primary{ background:var(--cube-red); color:#fff; font-family:'Space Grotesk',sans-serif; font-weight:600; }
  .btn-primary:hover{ filter:brightness(1.08); }

  ::selection{ background:var(--cube-yellow); color:#101218; }
</style>
</head>
<body class="antialiased min-h-screen flex flex-col">

<nav class="sticky top-0 z-50 border-b border-white/5" style="background:rgba(16,18,24,0.85); backdrop-filter:blur(10px);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-16 items-center relative">
      <div class="flex items-center gap-3 cursor-pointer" onclick="goToPage('index.html')">
        <img src="logo.png.jpeg" alt="Logo" class="h-9 w-auto rounded-full p-0.5 bg-white/90" onerror="this.onerror=null;this.src='https://placehold.co/40x40/101218/F2B705?text=T%26T';">
        <span class="font-display font-bold text-xl tracking-tight">Twist &amp; Turn</span>
      </div>
      <div class="flex items-center gap-2">
        <button id="menuBtn" class="md:hidden text-3xl leading-none text-[var(--ink)]">☰</button>
      </div>
      <div id="navLinks" class="hidden absolute top-full right-0 mt-2 w-full md:static md:mt-0 md:w-auto md:flex md:items-center md:space-x-1 text-right md:text-left font-mono text-sm uppercase tracking-wider" style="background:var(--bg-surface);">
        <button onclick="goToPage('index.html')" class="block w-full px-4 py-3 text-left hover:text-[var(--cube-yellow)] transition border-b-2 border-transparent hover:border-[var(--cube-yellow)] md:inline-block md:w-auto md:p-2">Home</button>
        <button onclick="goToPage('timer.html')" class="block w-full px-4 py-3 text-left hover:text-[var(--cube-red)] transition border-b-2 border-transparent hover:border-[var(--cube-red)] md:inline-block md:w-auto md:p-2">⏱️ Timer</button>
        <button onclick="goToPage('previous-competitions.html')" class="block w-full px-4 py-3 text-left hover:text-[var(--cube-blue)] transition border-b-2 border-transparent hover:border-[var(--cube-blue)] md:inline-block md:w-auto md:p-2">Previous</button>
        <button onclick="goToPage('index.html#rules')" class="block w-full px-4 py-3 text-left hover:text-[var(--cube-red)] transition border-b-2 border-transparent hover:border-[var(--cube-red)] md:inline-block md:w-auto md:p-2">Rules</button>
        <button onclick="goToPage('index.html#results')" class="block w-full px-4 py-3 text-left hover:text-[var(--cube-green)] transition border-b-2 border-transparent hover:border-[var(--cube-green)] md:inline-block md:w-auto md:p-2">Results</button>
        <button onclick="goToPage('index.html#contact')" class="block w-full px-4 py-3 text-left hover:text-[var(--cube-yellow)] transition border-b-2 border-transparent hover:border-[var(--cube-yellow)] md:inline-block md:w-auto md:p-2">Contact</button>
      </div>
    </div>
  </div>
</nav>

<main class="flex-grow">

  <section id="upcoming" class="py-16" style="background:var(--bg-surface);">
    <div class="max-w-5xl mx-auto px-4">
      <p class="eyebrow mb-2">Next Event</p>
      <h2 class="font-display text-3xl font-bold mb-8">Upcoming Competition</h2>

      <div id="upcoming-content" class="interactive-card surface-card accent-border-blue rounded-2xl shadow-2xl overflow-hidden">
        <div class="p-10 text-center"><p style="color:var(--ink-muted)">Loading...</p></div>
      </div>

      <div id="upcoming-extra" class="hidden">
        <div class="mt-12">
          <h3 class="font-display text-2xl font-bold mb-8 text-center">🏁 Competition Format</h3>
          <div class="grid md:grid-cols-5 gap-4 items-center">
            <div class="surface-card rounded-xl p-5 text-center">
              <h4 class="font-bold text-lg">Qualifier Round</h4>
              <p class="mt-2" style="color:var(--ink-muted);">All Participants</p>
            </div>
            <div class="text-center text-3xl font-bold" style="color:var(--cube-yellow);">➜</div>
            <div class="surface-card rounded-xl p-5 text-center">
              <h4 class="font-bold text-lg">Top 8</h4>
              <p class="mt-2" style="color:var(--ink-muted);">Qualified</p>
            </div>
            <div class="text-center text-3xl font-bold" style="color:var(--cube-yellow);">➜</div>
            <div class="surface-card rounded-xl p-5 text-center">
              <h4 class="font-bold text-lg">Grand Finals</h4>
              <p class="mt-2" style="color:var(--ink-muted);">Top 3 Winners</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
    import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";
    import { firebaseConfig } from "./firebase-config.js";

    const app = initializeApp(firebaseConfig);
    const db = getFirestore(app);
    const box = document.getElementById("upcoming-content");
    const extra = document.getElementById("upcoming-extra");

    getDoc(doc(db, "site", "upcomingCompetition")).then(snap => {
      if (!snap.exists() || !snap.data().status || snap.data().status === "none") {
        box.innerHTML = `
          <div class="p-10 text-center">
            <h2 class="font-display text-2xl md:text-3xl font-bold mb-4">No Upcoming Competition</h2>
            <p class="mb-6" style="color:var(--ink-muted)">There are currently no upcoming competitions.</p>
            <p class="text-lg font-semibold" style="color:var(--cube-yellow)">Stay tuned for our next event! 🚀</p>
          </div>`;
        extra.classList.add("hidden");
        return;
      }

      extra.classList.remove("hidden");
      const d = snap.data();

      document.title = (d.title || "Upcoming Competition") + " : Twist & Turn";

      const statusLabel = d.status === "open" ? "🟢 Registration Open" : "🔴 Registration Closed";
      const statusColor = d.status === "open" ? "var(--cube-green)" : "var(--cube-red)";

      const events = Array.isArray(d.events) ? d.events.filter(e => e && e.name) : [];

      const eventsHtml = events.length > 0 ? `
        <div class="max-w-3xl mx-auto mb-8">
          <div class="grid gap-3">
            ${events.map(ev => `
              <div class="surface-card rounded-xl p-4 flex flex-wrap items-center justify-between gap-2 text-left">
                <span class="font-display font-bold">🧩 ${ev.name}</span>
                <span>💰 ${ev.fee || "-"}</span>
                <span style="color:var(--ink-muted)">🏁 ${ev.format || d.format || "-"}</span>
              </div>`).join("")}
          </div>
        </div>` : "";

      box.innerHTML = `
        ${d.posterUrl ? `<img src="${d.posterUrl}" class="w-full h-auto">` : ""}
        <div class="p-8 text-center">
          <h2 class="font-display text-3xl font-bold mb-3">🔥 ${d.title || ""}</h2>
          <p class="text-lg mb-6" style="color:${statusColor};">${statusLabel}</p>
          <div class="grid md:grid-cols-2 gap-4 text-left max-w-3xl mx-auto mb-8">
            <div class="surface-card rounded-xl p-4"><b>📅 Date</b><br>${d.date || "-"}</div>
            <div class="surface-card rounded-xl p-4"><b>🌐 Mode</b><br>${d.mode || "-"}</div>
            <div class="surface-card rounded-xl p-4"><b>👥 Participants</b><br>${d.participantsLimit || "-"}</div>
            <div class="surface-card rounded-xl p-4"><b>🏁 Overall Format</b><br>${d.format || "-"}</div>
            ${d.baseFee ? `<div class="surface-card rounded-xl p-4"><b>💰 Base Entry Fee</b><br>${d.baseFee}</div>` : ""}
          </div>
          ${eventsHtml}
          ${d.details ? `<p class="mb-6" style="color:var(--ink-muted)">${d.details}</p>` : ""}
          ${d.regLink ? `<a href="${d.regLink}" target="_blank" class="btn-primary inline-block px-8 py-4 rounded-xl">Register Now 🚀</a>` : ""}
        </div>`;
    });
  </script>

</main>

<footer class="py-8 text-center font-mono text-xs" style="color:var(--ink-muted); border-top:1px solid rgba(255,255,255,0.06);">
  © 2026 Twist &amp; Turn — Speedcubing Arena
</footer>

  <script src="script.js"></script>
</body>
</html>
